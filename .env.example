# Copy this file to .env.local and fill in the values.
# The app still runs without them: guest mode + sample provider data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API (New) — server-only, never exposed to the browser.
# Without it the locator shows clearly-labelled SAMPLE places.
GOOGLE_PLACES_API_KEY=

# Optional, server-only: lets the app save website insurance checks to Supabase
# (table insurance_scans) so each site is read once a month instead of on every visit.
# Supabase → Project Settings → API → service_role / secret key. NEVER share or commit this.
SUPABASE_SERVICE_ROLE_KEY=
